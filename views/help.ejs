```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Help & Support | VidyaSetu</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #1f2937;
        }

        .page {
            max-width: 1100px;
            margin: auto;
            padding: 40px 25px;
        }

        /* HEADER */
        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .header p {
            color: #6b7280;
            font-size: 15px;
        }

        /* SEARCH */
        .search-box {
            background: white;
            padding: 20px;
            border-radius: 14px;
            margin-bottom: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }

        .search-box input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #ddd;
            border-radius: 9px;
            font-size: 15px;
            outline: none;
        }

        .search-box input:focus {
            border-color: #4f46e5;
        }

        /* SUPPORT CARDS */
        .support-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 35px;
        }

        .support-card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            text-align: center;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
            transition: 0.2s;
        }

        .support-card:hover {
            transform: translateY(-3px);
        }

        .icon {
            width: 50px;
            height: 50px;
            margin: 0 auto 15px;
            border-radius: 12px;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .support-card h3 {
            margin-bottom: 8px;
        }

        .support-card p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .support-card button {
            border: none;
            background: #4f46e5;
            color: white;
            padding: 9px 18px;
            border-radius: 7px;
            cursor: pointer;
        }

        .support-card button:hover {
            background: #4338ca;
        }

        /* FAQ */
        .faq-section {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }

        .faq-section h2 {
            margin-bottom: 20px;
        }

        .faq {
            border-bottom: 1px solid #eee;
        }

        .faq-question {
            width: 100%;
            padding: 17px 5px;
            background: none;
            border: none;
            text-align: left;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .faq-answer {
            display: none;
            padding: 0 5px 17px;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

        .faq.active .faq-answer {
            display: block;
        }

        .arrow {
            transition: 0.2s;
        }

        .faq.active .arrow {
            transform: rotate(180deg);
        }

        /* CONTACT */
        .contact-box {
            margin-top: 25px;
            background: #eef2ff;
            padding: 25px;
            border-radius: 14px;
            text-align: center;
        }

        .contact-box h2 {
            margin-bottom: 8px;
        }

        .contact-box p {
            color: #6b7280;
            margin-bottom: 15px;
        }

        .contact-btn {
            padding: 10px 20px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        /* RESPONSIVE */
        @media (max-width: 750px) {
            .support-cards {
                grid-template-columns: 1fr;
            }

            .page {
                padding: 25px 15px;
            }

            .header h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="page">

        <!-- HEADER -->
        <div class="header">
            <h1>Help & Support</h1>
            <p>
                Need help? Find answers to common questions or contact our support team.
            </p>
        </div>


        <!-- SEARCH -->
        <div class="search-box">
            <input
                type="text"
                id="searchInput"
                placeholder="Search for help..."
            >
        </div>


        <!-- SUPPORT OPTIONS -->
        <div class="support-cards">

            <div class="support-card">
                <div class="icon">❓</div>

                <h3>FAQs</h3>

                <p>
                    Find answers to frequently asked questions about VidyaSetu.
                </p>

                <button onclick="scrollToFAQ()">
                    View FAQs
                </button>
            </div>


            <div class="support-card">
                <div class="icon">💬</div>

                <h3>Contact Support</h3>

                <p>
                    Have a problem? Our support team is ready to help you.
                </p>

                <button onclick="contactSupport()">
                    Contact Us
                </button>
            </div>


            <div class="support-card">
                <div class="icon">📚</div>

                <h3>Guides</h3>

                <p>
                    Learn how to use VidyaSetu and explore its features.
                </p>

                <button onclick="showGuide()">
                    View Guides
                </button>
            </div>

        </div>


        <!-- FAQ -->
        <div class="faq-section" id="faqSection">

            <h2>Frequently Asked Questions</h2>


            <div class="faq">

                <button class="faq-question">
                    How do I update my profile?
                    <span class="arrow">▼</span>
                </button>

                <div class="faq-answer">
                    Go to your Profile section and click on Edit Profile.
                    Update your information and save the changes.
                </div>

            </div>


            <div class="faq">

                <button class="faq-question">
                    How does Skill Analysis work?
                    <span class="arrow">▼</span>
                </button>

                <div class="faq-answer">
                    Skill Analysis helps you understand your current skills
                    and identify areas where you can improve.
                </div>

            </div>


            <div class="faq">

                <button class="faq-question">
                    Where can I find internships?
                    <span class="arrow">▼</span>
                </button>

                <div class="faq-answer">
                    Open the Internships section from the sidebar to explore
                    available internship opportunities.
                </div>

            </div>


            <div class="faq">

                <button class="faq-question">
                    How can I contact a mentor?
                    <span class="arrow">▼</span>
                </button>

                <div class="faq-answer">
                    Visit the Mentorship section to explore mentors and
                    available mentoring opportunities.
                </div>

            </div>

        </div>


        <!-- CONTACT -->
        <div class="contact-box">

            <h2>Still need help?</h2>

            <p>
                Our support team is here to help you with your questions.
            </p>

            <button class="contact-btn" onclick="contactSupport()">
                Contact Support
            </button>

        </div>

    </div>


    <script>

        // FAQ OPEN / CLOSE
        const questions = document.querySelectorAll(".faq-question");

        questions.forEach(question => {

            question.addEventListener("click", () => {

                const faq = question.parentElement;

                faq.classList.toggle("active");

            });

        });


        // SCROLL TO FAQ
        function scrollToFAQ() {

            document.getElementById("faqSection").scrollIntoView({
                behavior: "smooth"
            });

        }


        // CONTACT SUPPORT
        function contactSupport() {

            alert(
                "Thank you for contacting VidyaSetu Support! Our team will get back to you soon."
            );

        }


        // GUIDES
        function showGuide() {

            alert(
                "Guides section is coming soon!"
            );

        }


        // SEARCH FAQ
        const searchInput = document.getElementById("searchInput");

        searchInput.addEventListener("input", function () {

            const searchText = this.value.toLowerCase();

            const faqs = document.querySelectorAll(".faq");

            faqs.forEach(faq => {

                const text = faq.innerText.toLowerCase();

                if (text.includes(searchText)) {
                    faq.style.display = "block";
                } else {
                    faq.style.display = "none";
                }

            });

        });

    </script>

</body>
</html>
```
