</div>

<!-- ================= MODAL 1: EDIT PROFILE & SCHOOLING (WITH PHOTO PICKER) ================= -->
<div class="modal-overlay" id="editModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Edit Profile & Schooling Details</h3>
            <button class="close-btn" id="closeEditBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="portfolioEditForm" class="modal-body">
            <h4 class="modal-section-title">Personal Info & Profile Photo</h4>
            
            <!-- Choose Profile Photo from Device OR URL -->
            <div class="form-group">
                <label>Profile Picture</label>
                <div class="photo-uploader-box">
                    <div class="upload-options-row">
                        <label for="inputAvatarFile" class="file-pick-btn">
                            <i data-lucide="image"></i> Choose Photo from Device
                        </label>
                        <input type="file" id="inputAvatarFile" accept="image/*" style="display: none;">
                        <span>OR</span>
                        <input type="text" id="inputImg" placeholder="Paste image web link...">
                    </div>
                    <div class="preview-area" id="avatarPreviewArea" style="display: none;">
                        <img id="avatarPreviewImg" src="" alt="Avatar Preview" class="profile-preview-thumb">
                        <button type="button" id="removeAvatarBtn" class="remove-photo-btn"><i data-lucide="trash-2"></i> Remove</button>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="inputName" required>
                </div>
                <div class="form-group">
                    <label>Location</label>
                    <input type="text" id="inputLocation">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="inputEmail" required>
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" id="inputPhone">
                </div>
            </div>

            <div class="form-group">
                <label>Professional Bio</label>
                <textarea id="inputBio" rows="2" required></textarea>
            </div>

            <h4 class="modal-section-title">1. University / College</h4>
            <div class="form-row">
                <div class="form-group">
                    <label>University / College Name</label>
                    <input type="text" id="inputCollege" required>
                </div>
                <div class="form-group">
                    <label>Degree / Qualification</label>
                    <input type="text" id="inputDegree" required>
                </div>
            </div>

            <div class="form-row three-col">
                <div class="form-group">
                    <label>Duration / Year</label>
                    <input type="text" id="inputYear">
                </div>
                <div class="form-group">
                    <label>Branch</label>
                    <input type="text" id="inputBranch">
                </div>
                <div class="form-group">
                    <label>CGPA</label>
                    <input type="text" id="inputCgpa">
                </div>
            </div>
            <div class="form-group">
                <label>Specialization</label>
                <input type="text" id="inputSpec">
            </div>

            <h4 class="modal-section-title">2. Class 12th Intermediate Schooling</h4>
            <div class="form-row">
                <div class="form-group">
                    <label>12th School Name</label>
                    <input type="text" id="input12School" placeholder="Enter school name">
                </div>
                <div class="form-group">
                    <label>Board / Stream</label>
                    <input type="text" id="input12Board" placeholder="e.g. CBSE / Science">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Passing Year</label>
                    <input type="text" id="input12Year" placeholder="e.g. 2024">
                </div>
                <div class="form-group">
                    <label>Percentage / Marks</label>
                    <input type="text" id="input12Score" placeholder="e.g. 88%">
                </div>
            </div>

            <h4 class="modal-section-title">3. Class 10th High Schooling</h4>
            <div class="form-row">
                <div class="form-group">
                    <label>10th School Name</label>
                    <input type="text" id="input10School" placeholder="Enter school name">
                </div>
                <div class="form-group">
                    <label>Board</label>
                    <input type="text" id="input10Board" placeholder="e.g. CBSE / ICSE">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Passing Year</label>
                    <input type="text" id="input10Year" placeholder="e.g. 2022">
                </div>
                <div class="form-group">
                    <label>Percentage / Marks</label>
                    <input type="text" id="input10Score" placeholder="e.g. 92%">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelModalBtn">Cancel</button>
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 2: ADD PROJECT ================= -->
<div class="modal-overlay" id="addProjectModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add New Project</h3>
            <button class="close-btn" id="closeAddProjectBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="addProjectForm" class="modal-body">
            <div class="form-group">
                <label>Project Name</label>
                <input type="text" id="pTitle" placeholder="e.g. Student Management System" required>
            </div>

            <div class="form-group">
                <label>Project Photo</label>
                <div class="photo-uploader-box">
                    <div class="upload-options-row">
                        <label for="pPhotoFile" class="file-pick-btn">
                            <i data-lucide="image"></i> Choose Photo from Device
                        </label>
                        <input type="file" id="pPhotoFile" accept="image/*" style="display: none;">
                        <span>OR</span>
                        <input type="text" id="pImg" placeholder="Paste Image URL link...">
                    </div>
                    
                    <div class="preview-area" id="previewArea" style="display: none;">
                        <img id="projectPreviewImg" src="" alt="Selected Preview">
                        <button type="button" id="removePhotoBtn" class="remove-photo-btn"><i data-lucide="trash-2"></i> Remove</button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Project Description</label>
                <textarea id="pDesc" rows="3" placeholder="Briefly explain what this project does..." required></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>GitHub Repository URL</label>
                    <input type="text" id="pGithub" placeholder="https://github.com/..." value="#">
                </div>
                <div class="form-group">
                    <label>Live Demo / Website URL</label>
                    <input type="text" id="pDemo" placeholder="https://..." value="#">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelAddProjectBtn">Cancel</button>
                <button type="submit" class="btn-primary">Add Project</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 3: ADD INTERNSHIP ================= -->
<div class="modal-overlay" id="addInternModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add Completed Internship</h3>
            <button class="close-btn" id="closeAddInternBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="addInternForm" class="modal-body">
            <div class="form-group">
                <label>Company / Organization Name</label>
                <input type="text" id="internCompany" placeholder="e.g. Microsoft, Google, TCS, Infosys" required>
            </div>

            <div class="form-group">
                <label>Internship Completion Certificate Photo</label>
                <div class="photo-uploader-box">
                    <div class="upload-options-row">
                        <label for="internCertFile" class="file-pick-btn">
                            <i data-lucide="file-check"></i> Choose Certificate Photo
                        </label>
                        <input type="file" id="internCertFile" accept="image/*" style="display: none;">
                        <span>OR</span>
                        <input type="text" id="internCertUrl" placeholder="Paste Certificate Image link...">
                    </div>
                    
                    <div class="preview-area" id="internPreviewArea" style="display: none;">
                        <img id="internPreviewImg" src="" alt="Certificate Preview">
                        <button type="button" id="removeInternCertBtn" class="remove-photo-btn"><i data-lucide="trash-2"></i> Remove</button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelAddInternBtn">Cancel</button>
                <button type="submit" class="btn-primary">Save Internship</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 4: ADD WORK EXPERIENCE ================= -->
<div class="modal-overlay" id="addExpModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add Work Experience</h3>
            <button class="close-btn" id="closeAddExpBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="addExpForm" class="modal-body">
            <div class="form-group">
                <label>Company / Workplace Name</label>
                <input type="text" id="expCompany" placeholder="e.g. Infosys / Tech Solutions" required>
            </div>

            <div class="form-group">
                <label>Job Title / Role</label>
                <input type="text" id="expRole" placeholder="e.g. Frontend Developer / Software Engineer" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Duration / Total Years</label>
                    <input type="text" id="expDuration" placeholder="e.g. 2 Years (2024 - 2026)" required>
                </div>
                <div class="form-group">
                    <label>Employment Type</label>
                    <select id="expType" class="form-select">
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Freelance">Freelance</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelAddExpBtn">Cancel</button>
                <button type="submit" class="btn-primary">Save Experience</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 5: ADD SKILL ================= -->
<div class="modal-overlay" id="addSkillModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add New Skill</h3>
            <button class="close-btn" id="closeAddSkillBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="addSkillForm" class="modal-body">
            <div class="form-group">
                <label>Skill Name</label>
                <input type="text" id="skillNameInput" placeholder="e.g. C++, React, Python, MySQL" required>
            </div>
            <div class="form-group">
                <label>Proficiency Level</label>
                <select id="skillLevelInput" class="form-select">
                    <option value="Advanced">Advanced (85-95%)</option>
                    <option value="Intermediate" selected>Intermediate (70-80%)</option>
                    <option value="Beginner">Beginner (50-60%)</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelAddSkillBtn">Cancel</button>
                <button type="submit" class="btn-primary">Add Skill</button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 6: ADD CERTIFICATE ================= -->
<div class="modal-overlay" id="addCertModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Add Certificate</h3>
            <button class="close-btn" id="closeAddCertBtn"><i data-lucide="x"></i></button>
        </div>
        <form id="addCertForm" class="modal-body">
            <div class="form-group">
                <label>Certificate Title</label>
                <input type="text" id="certTitle" placeholder="e.g. Meta Front-End Developer" required>
            </div>

            <div class="form-group">
                <label>Issuing Organization</label>
                <input type="text" id="certOrg" placeholder="e.g. Coursera, AWS, HackerRank" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Issue Date</label>
                    <input type="text" id="certDate" placeholder="e.g. May 2025" required>
                </div>
                <div class="form-group">
                    <label>Credential ID / Verification Link</label>
                    <input type="text" id="certId" placeholder="e.g. CERT-987123" required>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline" id="cancelAddCertBtn">Cancel</button>
                <button type="submit" class="btn-primary">Add Certificate</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/portfolio.js"></script>
</body>
</html>