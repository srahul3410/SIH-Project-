                                        </div>
                                        <span id="edu10Board">CBSE Board</span>
                                        <p id="edu10Details">Passing Year: 2022 • Score: 92%</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="grid-right">

                    <!-- Profile Strength -->
                    <div class="card side-card">
                        <h3>Profile Strength</h3>
                        <div class="strength-content">
