  <div class="main-wrapper">
    <header>
      <button class="header-hamburger-btn" onclick="toggleSidebar()" aria-label="Toggle Sidebar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1e293b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="searchInput" placeholder="Search internships, roles, skills, or companies..." oninput="handleSearch()" />
      </div>

      <div class="header-actions">
        <div class="icon-badge-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          <span class="badge">3</span>
        </div>
        <div class="user-profile">
          <div class="user-avatar"><%= user.name.trim().charAt(0).toUpperCase() %></div>
          <div class="user-meta">
            <div class="name"><%= user.name %></div>
            <div class="role">Student</div>
          </div>
        </div>
      </div>
    </header>

    <main class="content-area">
      <section class="banner">
        <div>
          <div class="banner-title">Internship Portal</div>
          <h1>Verified Industry Internships 🚀</h1>
          <p>Matched with your current skill profile & readiness index (78% match score)</p>
        </div>
      </section>

      <section class="stats-row">
        <button type="button" class="stat-card" data-filter="applied" onclick="filterByStat(this)">
          <div class="stat-icon icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </div>
          <div class="stat-info">
            <div class="stat-number" id="app-counter">12</div>
            <div class="stat-label">Applications Sent</div>
          </div>
        </button>

        <button type="button" class="stat-card" data-filter="review" onclick="filterByStat(this)">
          <div class="stat-icon icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="stat-info">
            <div class="stat-number">3</div>
            <div class="stat-label">Under Review</div>
          </div>
        </button>

        <button type="button" class="stat-card" data-filter="interview" onclick="filterByStat(this)">
          <div class="stat-icon icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="stat-info">
            <div class="stat-number">2</div>
            <div class="stat-label">Interviews Scheduled</div>
          </div>
        </button>

        <button type="button" class="stat-card active" data-filter="high-match" onclick="filterByStat(this)">
          <div class="stat-icon icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
              <path d="M5 3v4"></path>
              <path d="M19 17v4"></path>
              <path d="M3 5h4"></path>
              <path d="M17 19h4"></path>
            </svg>
          </div>
          <div class="stat-info">
            <div class="stat-number">48</div>
            <div class="stat-label">High-Match Openings</div>
          </div>
        </button>
      </section>

      <div class="portal-layout">
        <aside class="filter-panel">
          <div class="filter-header">
            <h3>Filters</h3>
            <span class="reset-btn" onclick="resetFilters()">Reset All</span>
          </div>

          <div class="filter-group">
            <label>Work Type</label>
            <div class="filter-checkboxes">
              <label class="filter-checkbox"><input type="checkbox" checked /> Remote</label>
              <label class="filter-checkbox"><input type="checkbox" /> On-site</label>
              <label class="filter-checkbox"><input type="checkbox" checked /> Hybrid</label>
            </div>
          </div>

          <div class="filter-group">
            <label>Duration</label>
            <div class="filter-checkboxes">
              <label class="filter-checkbox"><input type="checkbox" /> 1 - 3 Months</label>
              <label class="filter-checkbox"><input type="checkbox" checked /> 3 - 6 Months</label>
              <label class="filter-checkbox"><input type="checkbox" /> 6+ Months</label>
            </div>
          </div>

          <div class="filter-group">
            <label>Matched Skills</label>
            <div class="filter-checkboxes">
              <label class="filter-checkbox"><input type="checkbox" checked /> C++ / DSA</label>
              <label class="filter-checkbox"><input type="checkbox" checked /> Problem Solving</label>
              <label class="filter-checkbox"><input type="checkbox" /> SQL & Databases</label>
              <label class="filter-checkbox"><input type="checkbox" /> Fullstack Development</label>
            </div>
          </div>
        </aside>

        <section class="jobs-feed">
          <article class="internship-card" data-status="high-match" data-role="Software Engineering Intern" data-company="Microsoft">
            <div class="card-top">
              <div class="company-info">
                <div class="company-logo">
                  <svg viewBox="0 0 21 21" width="28" height="28">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                    <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                    <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                  </svg>
                </div>
                <div class="role-info">
                  <h3>Software Engineering Intern</h3>
                  <p>Microsoft • Bengaluru, India (Hybrid)</p>
                </div>
              </div>
              <div class="match-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                95% Match
              </div>
            </div>
            <div class="card-tags">
              <span class="tag highlight">C++</span>
              <span class="tag highlight">DSA</span>
              <span class="tag highlight">OOP</span>
              <span class="tag">Problem Solving</span>
              <span class="tag">Azure</span>
            </div>
            <div class="card-details">
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                6 Months
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Bengaluru
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Apply by 25 Sep
              </div>
            </div>
            <div class="card-bottom">
              <div class="stipend">₹45,000 <span>/month</span></div>
              <div class="action-group">
                <button class="btn-save">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                </button>
                <button class="btn-apply" onclick="openApplyModal(this)">Apply Now</button>
              </div>
            </div>
          </article>

          <article class="internship-card" data-status="review" data-role="Data Analyst Intern" data-company="Deloitte">
            <div class="card-top">
              <div class="company-info">
                <div class="company-logo">
                  <svg viewBox="0 0 100 30" width="42" height="16">
                    <text x="0" y="22" font-size="24" font-weight="900" fill="#000" font-family="Arial, sans-serif">Deloitte</text>
                    <circle cx="92" cy="20" r="3.5" fill="#86bc25"/>
                  </svg>
                </div>
                <div class="role-info">
                  <h3>Data Analyst Intern</h3>
                  <p>Deloitte • Gurugram, India (On-site)</p>
                </div>
              </div>
              <div class="match-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                90% Match
              </div>
            </div>
            <div class="card-tags">
              <span class="tag highlight">SQL</span>
              <span class="tag highlight">Python</span>
              <span class="tag">Excel</span>
              <span class="tag">Data Analytics</span>
            </div>
            <div class="card-details">
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                3 Months
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Gurugram
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Apply by 20 Sep
              </div>
            </div>
            <div class="card-bottom">
              <div class="stipend">₹30,000 <span>/month</span></div>
              <div class="action-group">
                <button class="btn-save">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                </button>
                <button class="btn-apply" onclick="openApplyModal(this)">Apply Now</button>
              </div>
            </div>
          </article>

          <article class="internship-card" data-status="interview" data-role="Backend Developer Trainee" data-company="Tata Consultancy Services">
            <div class="card-top">
              <div class="company-info">
                <div class="company-logo">
                  <svg viewBox="0 0 80 32" width="40" height="18">
                    <text x="5" y="24" font-size="24" font-weight="900" fill="#0a3b7c" font-family="sans-serif">TCS</text>
                  </svg>
                </div>
                <div class="role-info">
                  <h3>Backend Developer Trainee</h3>
                  <p>Tata Consultancy Services • Remote</p>
                </div>
              </div>
              <div class="match-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                88% Match
              </div>
            </div>
            <div class="card-tags">
              <span class="tag highlight">C++</span>
              <span class="tag highlight">OOP</span>
              <span class="tag">System Design</span>
              <span class="tag">Git</span>
            </div>
            <div class="card-details">
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                6 Months
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg>
                Fully Remote
              </div>
              <div class="detail-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Apply by 30 Sep
              </div>
            </div>
            <div class="card-bottom">
              <div class="stipend">₹25,000 <span>/month</span></div>
              <div class="action-group">
                <button class="btn-save">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                </button>
                <button class="btn-apply" onclick="openApplyModal(this)">Apply Now</button>
              </div>
            </div>
          </article>
        </section>
      </div>
    </main>
  </div>

  <div class="modal-backdrop" id="apply-modal">
    <div class="modal-card">
      <button class="modal-close" onclick="closeApplyModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      
      <div id="modal-form-content">
        <h3 id="modal-role">Apply for Position</h3>
        <p id="modal-company" class="modal-subtitle">Company Name</p>

        <form id="quick-apply-form" onsubmit="handleApplySubmit(event)">
          <div class="form-group">
            <label>Applicant Name</label>
            <input type="text" value="<%= user.name %>" required />
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" value="<%= user.email %>" required />
          </div>
          <div class="form-group">
            <label>Current Resume</label>
            <div class="file-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0d826a" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/></svg>
              <span><%= user.name.trim().replace(/\s+/g, "_") %>_Resume_2026.pdf</span>
            </div>
          </div>
          <button type="submit" class="btn-submit" id="submit-btn">Submit Application</button>
        </form>
      </div>

      <div id="modal-success-content" class="success-box" style="display: none;">
        <div class="success-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3>Application Submitted!</h3>
        <p>Your profile and readiness report have been shared with the recruitment team.</p>
        <button class="btn-apply" onclick="closeApplyModal()">Close</button>
      </div>
    </div>
  </div>

  <script src="/js/internship.js"></script>
</body>
</html>