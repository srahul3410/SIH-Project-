<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIC Portal - Login</title>
    <link rel="stylesheet" href="/css/login.css">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>
<body>
    
<div class="login-page">
    <div class="login-card">
        <div class="login-icon">
            <i class="fa-solid fa-graduation-cap"></i>
        </div>

        <h1>Welcome Back!</h1>

        <p class="subtitle">
            Login to continue to AIC Portal
        </p>
        <form id="loginForm"  method="POST" action="/login">

            <label>Email </label>
            <input
                type="text"
                id="email"
                placeholder="Enter your email "
                required
            >
            <label>Password</label>
            <div class="password-box">
                <input
                    type="password"
                    id="password"
                    placeholder="Enter password"
                    required
                >
                <i
                    class="fa-solid fa-eye"
                    id="togglePassword"
                ></i>
            </div>
            <a href="#" class="forgot">
                Forgot Password?
            </a>
            <button type="submit" class="login" onclick="window.location.href='/dashboard'">
                Login
            </button>
        </form>

        <div class="or">
            <span>or continue with</span>
        </div>
        <div class="social-login">
            <button>
                <i class="fa-brands fa-google"></i>
            </button>
            <button>
                <i class="fa-brands fa-linkedin-in"></i>
            </button>
            <button>
                <i class="fa-brands fa-github"></i>
            </button>
        </div>

        <p class="signup-text">
            Don't have an account?
            <a href="/signup" id="signupLink">Sign Up</a>
        </p>
    </div>

</div>

<!-- <script src="login.js"></script> -->
<script>
    const error = "<%= error || '' %>";

    if (error === "signup") {
        alert("Account doesnt exit! Please Sign Up.");
    }

    if (error === "wrongpassword") {
        alert("Wrong password!");
    }
</script>

</body>
</html>