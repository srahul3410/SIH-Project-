<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login page</title>
<link rel="stylesheet" href="/css/login.css">
</head>
<body>

  <div class="page">

    <!-- LEFT PANEL -->
    <div class="left-panel">
      <canvas id="globeCanvas"></canvas>

      <div class="brand">
        <img src="public/ima" alt="Logo" class="brand-logo">
        <span class="Vidya Setu">Vidya Setu</span>
      </div>

      <div class="left-content">
        <p class="welcome-label">Welcome to</p>
        <h1>Our Community</h1>
        <p class="left-desc">Home to millions of developers worldwide</p>
        <a href="#" class="know-more">Know more</a>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
      <div class="form-wrap">
        <h2>Welcome</h2>
        <h3>Login to your account</h3>

        <form id="loginForm" method="POST" action="/login" novalidate>
          <div class="input-container">
            <input type="email" id="email" name="email" placeholder="Your username or email" required>
            <span id="emailError" class="error-msg">Please enter a valid email address.</span>
          </div>

          <div class="input-container">
            <input type="password" id="password" name="password" placeholder="Your password" required>
          </div>

          <button type="submit" class="login-btn">Log In</button>

          <div class="row-between">
            <label class="remember">
              <input type="checkbox" checked>
              Remember me
            </label>
            <a href="#" class="forgot">Forgot password?</a>
          </div>

          <div class="divider"><span>or</span></div>

          <button type="button" class="social-btn google-btn">
            <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62Z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.96v2.33A9 9 0 0 0 9 18Z"/><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.03l2.99-2.33Z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.97l2.99 2.33C4.66 5.17 6.65 3.58 9 3.58Z"/></svg>
            Continue with Google
          </button>

          <div class="social-row">
            <button type="button" class="social-btn small-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#0A66C2"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
              LinkedIn
            </button>
            <button type="button" class="social-btn small-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#181717"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.42.36.78 1.07.78 2.16v3.2c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
              GitHub
            </button>
          </div>
        </form>

        <p class="signup-text">Don't have an account? <a href="/signup">Sign up</a></p>
      </div>
    </div>

  </div>

<script src="/js/login.js"></script>
</body>
</html>