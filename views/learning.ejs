  <div id="playlistModal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-top">
        <div class="modal-info">
          <h3 id="currentCourseTitle">Course Playlist</h3>
          <p id="currentVideoTitle">Select a lecture to start streaming</p>
        </div>
        <button class="modal-close-btn" onclick="closeCourseModal()">&times;</button>
      </div>

      <div class="modal-body">
        <div class="player-panel">
          <div class="video-frame-wrapper">
            <iframe 
              id="activeVideoPlayer" 
              src="" 
              title="Lecture Player" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <div class="playlist-panel">
          <div class="playlist-header">
            <span>Lectures &amp; Modules</span>
            <span class="lecture-count" id="lectureCounter">0 Lessons</span>
          </div>
          <div class="lecture-list" id="lectureListContainer"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/learning.js"></script>
