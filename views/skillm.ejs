<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Skill Mapping</title>

    <link rel="stylesheet" href="/css/skillm.css">

</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <h2>🎓 AIC Portal</h2>

            <a href="../overview/index.html">Dashboard</a>

            <a href="../profile/view/index.html">
                My Profile
            </a>

            <a href="../skill-assessment/index.html">
                Skill Assessment
            </a>

            <a href="#" class="active">
                Skill Mapping
            </a>

            <a href="../opportunities/index.html">
                Opportunities
            </a>

            <a href="../applications/index.html">
                Applications
            </a>

            <a href="../messages/index.html">
                Messages
            </a>

            <a href="../learning/index.html">
                Learning
            </a>

        </aside>


        <main class="main">

            <div class="heading">

                <h1>Skill Mapping</h1>

                <p>
                    Discover your strengths, gaps and recommended skills
                </p>

            </div>


            <div class="top-grid">

                <div class="score-card">

                    <h3>Your Skill Profile</h3>

                    <div class="circle">
                        78%
                    </div>

                    <p>Overall Score</p>

                </div>


                <div class="strength">

                    <h3>Skill Strength</h3>

                    <div>
                        Technical Skills
                        <span>82%</span>
                    </div>

                    <div>
                        Soft Skills
                        <span>75%</span>
                    </div>

                    <div>
                        Problem Solving
                        <span>78%</span>
                    </div>

                </div>

            </div>


            <!-- SKILL GAP -->

            <div class="card">

                <h2>Skill Gap Analysis</h2>

                <p>Skills to improve</p>

                <div class="tags">

                    <span>Machine Learning</span>
                    <span>Cloud Computing</span>
                    <span>System Design</span>
                    <span>DevOps</span>

                </div>

            </div>


            <!-- SKILLS -->

            <div class="card">

                <h2>Technical Skills</h2>

                <table>

                    <thead>

                        <tr>
                            <th>Skill</th>
                            <th>Your Level</th>
                            <th>Industry Demand</th>
                            <th>Match</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Python</td>
                            <td>Advanced</td>
                            <td>●●●●●●</td>
                            <td>90%</td>
                        </tr>

                        <tr>
                            <td>JavaScript</td>
                            <td>Advanced</td>
                            <td>●●●●●</td>
                            <td>85%</td>
                        </tr>

                        <tr>
                            <td>HTML & CSS</td>
                            <td>Advanced</td>
                            <td>●●●●●●</td>
                            <td>90%</td>
                        </tr>

                        <tr>
                            <td>Node.js</td>
                            <td>Intermediate</td>
                            <td>●●●●●</td>
                            <td>75%</td>
                        </tr>

                        <tr>
                            <td>MongoDB</td>
                            <td>Intermediate</td>
                            <td>●●●●</td>
                            <td>70%</td>
                        </tr>

                        <tr>
                            <td>C++</td>
                            <td>Intermediate</td>
                            <td>●●●●</td>
                            <td>60%</td>
                        </tr>

                        <tr>
                            <td>Data Structures</td>
                            <td>Advanced</td>
                            <td>●●●●●●</td>
                            <td>85%</td>
                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- RECOMMENDATIONS -->

            <div class="card">

                <h2>Learning Recommendations</h2>

                <div class="recommendations">

                    <div>
                        <strong>Machine Learning A-Z</strong>
                        <span>92% match</span>
                    </div>

                    <div>
                        <strong>AWS Cloud Practitioner</strong>
                        <span>85% match</span>
                    </div>

                    <div>
                        <strong>System Design Basics</strong>
                        <span>80% match</span>
                    </div>

                </div>

            </div>


            <!-- CAREER -->

            <div class="career">

                <h2>Top Career Matches For You</h2>

                <span>Full Stack Developer</span>
                <span>Backend Developer</span>
                <span>Software Engineer</span>
                <span>Web Developer</span>

            </div>

        </main>

    </div>

    <script src="skillm.js"></script>

</body>

</html>