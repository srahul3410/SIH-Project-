<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile</title>

    <link rel="stylesheet" href="/css/profile.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

<div class="dashboard">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div>
                <h3>AIC Portal</h3>
                <small>Bridging Academia & Industry</small>
            </div>

        </div>


        <a href="../../overview/index.html" class="menu">
            <i class="fa-solid fa-house"></i>
            Dashboard
        </a>


        <div class="title">MAIN</div>


        <a href="#" class="menu active">
            <i class="fa-regular fa-user"></i>
            My Profile
        </a>

        <a href="../../skill-assessment/index.html" class="menu">
            <i class="fa-solid fa-clipboard-check"></i>
            Skill Assessment
        </a>

        <a href="../../skill-mapping/index.html" class="menu">
            <i class="fa-solid fa-diagram-project"></i>
            Skill Mapping
        </a>

        <a href="../../opportunities/index.html" class="menu">
            <i class="fa-solid fa-briefcase"></i>
            Opportunities
        </a>

        <a href="../../applications/index.html" class="menu">
            <i class="fa-regular fa-file-lines"></i>
            Applications
        </a>

        <a href="../../messages/index.html" class="menu">
            <i class="fa-regular fa-message"></i>
            Messages
        </a>

        <a href="../../learning/index.html" class="menu">
            <i class="fa-solid fa-book-open"></i>
            Learning
        </a>


        <div class="title">SETTINGS</div>

        <a href="../../settings/index.html" class="menu">
            <i class="fa-solid fa-gear"></i>
            Settings
        </a>

        <a href="#" class="menu">
            <i class="fa-regular fa-circle-question"></i>
            Help & Support
        </a>

        <a href="#" class="menu logout">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            Logout
        </a>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input
                    type="text"
                    placeholder="Search opportunities, skills..."
                >
            </div>


            <div class="top-user">

                <i class="fa-regular fa-bell"></i>

                <div class="avatar">
                    S
                </div>

                <div>
                    <strong>Saniya Siddique</strong>
                    <small>Student</small>
                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">

            <div class="page-heading">

                <div>
                    <h1>My Profile</h1>
                    <p>Your professional identity and career profile</p>
                </div>

                <button id="editProfile">
                    <i class="fa-solid fa-pen"></i>
                    Edit Profile
                </button>

            </div>


            <!-- PROFILE CARD -->

            <div class="profile-card">

                <div class="profile-top">

                    <div class="profile-image">
                        S
                    </div>


                    <div class="profile-details">

                        <h2>Saniya Siddique</h2>

                        <p>B.Tech CSE • 2nd Year</p>

                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            Lucknow, Uttar Pradesh
                        </p>

                        <span class="status">
                            Aspiring Software Developer
                        </span>

                    </div>

                </div>


                <!-- CONNECT -->

                <div class="connect">

                    <h3>Connect with me</h3>

                    <div class="socials">

                        <a href="#">
                            <i class="fa-brands fa-linkedin"></i>
                            <span>LinkedIn</span>
                        </a>

                        <a href="#">
                            <i class="fa-brands fa-github"></i>
                            <span>GitHub</span>
                        </a>

                        <a href="#">
                            <i class="fa-solid fa-code"></i>
                            <span>LeetCode</span>
                        </a>

                        <a href="#">
                            <i class="fa-solid fa-laptop-code"></i>
                            <span>CodeChef</span>
                        </a>

                        <a href="#">
                            <i class="fa-regular fa-envelope"></i>
                            <span>Portfolio</span>
                        </a>

                        <a href="#">
                            <i class="fa-solid fa-ellipsis"></i>
                            <span>More</span>
                        </a>

                    </div>

                </div>

            </div>


            <!-- ABOUT -->

            <div class="card">

                <h2>About Me</h2>

                <p class="about-text">
                    Passionate about solving real-world problems through
                    code. I enjoy working on full-stack development and
                    exploring new technologies.
                </p>

            </div>


            <!-- TABS -->

            <div class="tabs">

                <button class="tab active">Overview</button>
                <button class="tab">Education</button>
                <button class="tab">Projects</button>
                <button class="tab">Certifications</button>
                <button class="tab">Achievements</button>
                <button class="tab">Resume</button>

            </div>


            <!-- STATS -->

            <div class="stats">

                <div class="stat-card">

                    <i class="fa-solid fa-code"></i>

                    <strong>12+</strong>

                    <span>Skills</span>

                </div>


                <div class="stat-card">

                    <i class="fa-solid fa-folder-open"></i>

                    <strong>4</strong>

                    <span>Projects</span>

                </div>


                <div class="stat-card">

                    <i class="fa-solid fa-certificate"></i>

                    <strong>6</strong>

                    <span>Certificates</span>

                </div>


                <div class="stat-card">

                    <i class="fa-solid fa-trophy"></i>

                    <strong>3</strong>

                    <span>Achievements</span>

                </div>

            </div>

        </section>

    </main>

</div>

<script src="profile.js"></script>

</body>
</html>